ELEVENLABS_API_KEY=put_your_new_key_here

# --- Optional local Piper TTS (offline, CPU-only) -------------------------------
# Enable the local Piper provider. Requires:
#   .venv\Scripts\pip install -r requirements-piper.txt
#   model files (.onnx + .onnx.json) in RF_PIPER_MODEL_DIR — see
#   docs/PIPER_SETUP_RU.md or run scripts/download_piper_models.ps1
# If Piper is not installed or models are missing, the provider reports
# "unavailable" and everything falls back to Edge — nothing breaks.
RF_PIPER_ENABLED=1
RF_PIPER_MODEL_DIR=piper-models
RF_PIPER_DEFAULT_VOICE=ru_RU-denis-medium

# --- Optional local XTTS (GPU, high quality) ------------------------------------
# Requires:  .venv\Scripts\pip install -r requirements-xtts.txt
# and a reference speaker wav for RF_XTTS_SPEAKER_WAV (see requirements-xtts.txt).
# RF_XTTS_DEVICE: auto | cuda | cpu  (auto = CUDA, CPU fallback disabled unless cpu)
RF_XTTS_ENABLED=0
RF_XTTS_DEVICE=auto
RF_XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
RF_XTTS_SPEAKER_WAV=

# --- Optional external local TTS (any engine in its own venv: XTTS/F5/Fish) -------
# Universal bridge: RadioForge calls RF_EXTERNAL_TTS_COMMAND with a JSON job on
# stdin ({text, voice, language, output}) and expects WAV written to "output".
# Example:  RF_EXTERNAL_TTS_COMMAND="C:\path\.venv-xtts\Scripts\python.exe" "C:\path\xtts_worker.py"
# See docs/LOCAL_GPU_TTS_RU.md for the worker contract and a sample script.
RF_EXTERNAL_TTS_ENABLED=0
RF_EXTERNAL_TTS_COMMAND=
RF_EXTERNAL_TTS_TIMEOUT=120
RF_EXTERNAL_TTS_VOICE_LABEL=Local GPU
